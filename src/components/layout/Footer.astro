---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { name: 'GitHub', href: 'https://github.com/Base29', icon: 'github' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/faisal-hussain-28384518/', icon: 'linkedin' },
  { name: 'Email', href: 'mailto:me@imfaisal.pro', icon: 'mail' },
];
---

<footer class="relative border-t border-border/50 bg-background/50 backdrop-blur-sm overflow-hidden">
  <!-- Subtle ambient glow at bottom -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-32 bg-primary/5 blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Identity & Bio -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-cyan-500 to-indigo-600 flex items-center justify-center text-white font-bold text-sm">
            FH
          </div>
          <span class="font-display font-bold text-lg text-foreground tracking-tight">Faisal Hussain</span>
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed max-w-md">
          Solutions Architect & Full-Stack Developer with 15+ years of experience engineering high-scale distributed systems, enterprise platforms, and production AI/LLM solutions.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Open for Architecture & Advisory Roles
          </span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono uppercase tracking-wider text-muted-foreground">Navigation</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="#home" class="text-foreground/80 hover:text-primary transition-colors">Overview</a></li>
          <li><a href="#about" class="text-foreground/80 hover:text-primary transition-colors">About & Pillars</a></li>
          <li><a href="#experience" class="text-foreground/80 hover:text-primary transition-colors">Career Timeline</a></li>
          <li><a href="#skills" class="text-foreground/80 hover:text-primary transition-colors">Tech Capabilities</a></li>
          <li><a href="#projects" class="text-foreground/80 hover:text-primary transition-colors">Featured Projects</a></li>
          <li><a href="#contact" class="text-foreground/80 hover:text-primary transition-colors">Get in Touch</a></li>
        </ul>
      </div>

      <!-- Col 3: Direct Connect & Specs -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono uppercase tracking-wider text-muted-foreground">Direct Connect</h4>
        <div class="space-y-2 text-sm text-muted-foreground">
          <p class="text-foreground font-mono text-xs">me@imfaisal.pro</p>
          <p class="text-xs font-mono">+92 322 2911199</p>
          <p class="text-xs">Lahore, Pakistan · Remote Worldwide</p>
        </div>
        <div class="pt-2 flex items-center gap-2">
          {socialLinks.map((item) => (
            <a
              href={item.href}
              target={item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="w-9 h-9 rounded-lg border border-border bg-secondary/40 flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-secondary transition-all"
              aria-label={item.name}
            >
              {item.name === 'GitHub' && (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path></svg>
              )}
              {item.name === 'LinkedIn' && (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path></svg>
              )}
              {item.name === 'Email' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              )}
            </a>
          ))}
        </div>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="pt-8 border-t border-border/40 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted-foreground">
      <div class="flex items-center gap-2">
        <span>© {currentYear} Faisal Hussain. All rights reserved.</span>
      </div>

      <div class="flex items-center gap-4">
        <a href="#home" class="hover:text-foreground transition-colors flex items-center gap-1">
          Back to top ↑
        </a>
      </div>
    </div>
  </div>
</footer>
