---

<section id="skills" class="py-24 relative overflow-hidden border-t border-border/30">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="max-w-2xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-primary/10 text-primary mb-3">
        <span>TECHNICAL CAPABILITIES & TOOLING</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-foreground leading-tight">
        Engineered for full-lifecycle excellence.
      </h2>
      <p class="text-sm sm:text-base text-muted-foreground mt-4">
        Deep technical foundations developed over a decade and a half, continuously augmented with modern AI and edge platforms.
      </p>
    </div>

    <!-- Skills Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillCategories.map((cat) => (
        <div class="p-6 rounded-2xl glass-panel border border-border/70 card-hover-effect flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[10px] font-mono uppercase tracking-wider text-primary font-bold px-2 py-0.5 rounded bg-primary/10">
                {cat.badge}
              </span>
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            </div>

            <h3 class="font-display font-bold text-lg text-foreground mb-1">
              {cat.title}
            </h3>
            <p class="text-xs text-muted-foreground mb-5 font-mono">
              {cat.subtitle}
            </p>

            <div class="flex flex-wrap gap-2">
              {cat.skills.map((skill) => (
                <div class="group/item inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-mono bg-secondary/50 text-foreground border border-border/40 hover:border-primary/40 transition-colors">
                  <span>{skill.name}</span>
                  <span class="text-[10px] text-muted-foreground/70 font-sans group-hover/item:text-primary transition-colors">
                    · {skill.level}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
